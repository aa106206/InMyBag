EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
EXPO_PUBLIC_SAM2_SERVER_URL=http://your-laptop-ip:8000
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# AI server. The Python server auto-loads this file, so no shell export is needed.
GEMINI_API_KEY=your_gemini_api_key_here

# Claude Code <-> Supabase MCP. Read by .mcp.json at MCP server launch.
# Token: https://supabase.com/dashboard/account/tokens (starts with sbp_)
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token
# Project Settings -> General -> Reference ID (same as the sub-domain above)
SUPABASE_PROJECT_REF=your-project-ref
